# Copy to .env and fill in what you have. Keys stay on the server and never reach the browser.
# FINOVA AI uses OpenAI if OPENAI_API_KEY is set, otherwise Gemini, otherwise an offline lesson-based tutor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: live YouTube search for lesson videos. Without it, lessons link to YouTube searches instead.
YOUTUBE_API_KEY=
PORT=3000
# Optional, for future cloud accounts (public anon key; data protected by Row Level Security)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Copy to .env and fill in what you have. Keys stay on the server and never reach the browser.
# FINOVA AI uses OpenAI if OPENAI_API_KEY is set, otherwise Gemini, otherwise an offline lesson-based tutor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: live YouTube search for lesson videos. Without it, lessons link to YouTube searches instead.
YOUTUBE_API_KEY=
PORT=3000
# Optional, for future cloud accounts (public anon key; data protected by Row Level Security)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Memberships & billing (server only; never put secrets in VITE_ variables) ----
# Test mode lets you try subscriptions with NO payment. Turn it off in production.
BILLING_TEST_MODE=false
# Razorpay (web, India + international cards). Create Plans in the Razorpay dashboard (₹149 and ₹299 monthly).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_ELITE=
# Google Play Billing (Android). Service account JSON with Android Publisher access (store outside the repo).
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
PLAY_PRODUCT_PRO=
PLAY_PRODUCT_ELITE=
